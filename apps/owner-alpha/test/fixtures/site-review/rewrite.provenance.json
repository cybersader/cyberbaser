{"schema":"cyberbaser.source-provenance","version":2,"source":{"path":"rewrite/testing-a-backup.md","byteLength":502,"sha256":"4a764f3c7a46a61cfa8b127b45b6fcd01e7e095e80d1f7bde0c80147120fc9c0"},"leaves":[{"id":"cb0.0","parent":"cb0","child":0,"text":"Testing a backup","runs":[{"rendered":[0,16],"source":[2,18],"kind":"exact"}],"exact":[2,18]},{"id":"$body.1","parent":"$body","child":1,"text":"\n","runs":[{"rendered":[0,1],"reason":"generated-whitespace"}]},{"id":"cb1.0","parent":"cb1","child":0,"text":"A successful backup job tells you the copy finished. A restore test tells you whether you can use it.","runs":[{"rendered":[0,101],"source":[20,121],"kind":"exact"}],"exact":[20,121]},{"id":"$body.3","parent":"$body","child":3,"text":"\n","runs":[{"rendered":[0,1],"reason":"generated-whitespace"}]},{"id":"cb2.0","parent":"cb2","child":0,"text":"Run a restore test","runs":[{"rendered":[0,18],"source":[126,144],"kind":"exact"}],"exact":[126,144]},{"id":"$body.5","parent":"$body","child":5,"text":"\n","runs":[{"rendered":[0,1],"reason":"generated-whitespace"}]},{"id":"cb3.0","parent":"cb3","child":0,"text":"Restore some files somewhere and see if it worked. If nothing complains, the backup is probably fine for now.","runs":[{"rendered":[0,109],"source":[146,255],"kind":"exact"}],"exact":[146,255]},{"id":"$body.7","parent":"$body","child":7,"text":"\n","runs":[{"rendered":[0,1],"reason":"generated-whitespace"}]},{"id":"cb4.0","parent":"cb4","child":0,"text":"Look at a few files when you have time. If they open at all, you can assume the rest of them are fine.","runs":[{"rendered":[0,102],"source":[257,359],"kind":"exact"}],"exact":[257,359]},{"id":"$body.9","parent":"$body","child":9,"text":"\n","runs":[{"rendered":[0,1],"reason":"generated-whitespace"}]},{"id":"cb5.0","parent":"cb5","child":0,"text":"Delete the test copy when you are done so it does not take up space on the drive afterwards.","runs":[{"rendered":[0,92],"source":[361,453],"kind":"exact"}],"exact":[361,453]},{"id":"$body.11","parent":"$body","child":11,"text":"\n","runs":[{"rendered":[0,1],"reason":"generated-whitespace"}]},{"id":"cb6.0","parent":"cb6","child":0,"text":"Record the result","runs":[{"rendered":[0,17],"source":[458,475],"kind":"exact"}],"exact":[458,475]},{"id":"$body.13","parent":"$body","child":13,"text":"\n","runs":[{"rendered":[0,1],"reason":"generated-whitespace"}]},{"id":"cb7.0","parent":"cb7","child":0,"text":"Keep one entry per test.","runs":[{"rendered":[0,24],"source":[477,501],"kind":"exact"}],"exact":[477,501]}],"blocks":[{"id":"block0","parent":"cb0","source":[0,18],"editable":true,"text":"# Testing a backup"},{"id":"block1","parent":"cb1","source":[20,121],"editable":true,"text":"A successful backup job tells you the copy finished. A restore test tells you whether you can use it."},{"id":"block2","parent":"cb2","source":[123,144],"editable":true,"text":"## Run a restore test"},{"id":"block3","parent":"cb3","source":[146,255],"editable":true,"text":"Restore some files somewhere and see if it worked. If nothing complains, the backup is probably fine for now."},{"id":"block4","parent":"cb4","source":[257,359],"editable":true,"text":"Look at a few files when you have time. If they open at all, you can assume the rest of them are fine."},{"id":"block5","parent":"cb5","source":[361,453],"editable":true,"text":"Delete the test copy when you are done so it does not take up space on the drive afterwards."},{"id":"block6","parent":"cb6","source":[455,475],"editable":true,"text":"## Record the result"},{"id":"block7","parent":"cb7","source":[477,501],"editable":true,"text":"Keep one entry per test."}]}
