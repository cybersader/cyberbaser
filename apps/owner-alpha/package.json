{
  "name": "@cyberbaser/owner-alpha",
  "version": "0.1.0",
  "private": true,
  "description": "Private owner-alpha editor and automatic publish pipeline for Cyberbaser, bound to one owner-chosen private network address.",
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "bash bin/start.sh",
    "wiki": "bash bin/launch.sh",
    "test": "bun test test",
    "test:server": "bun test test/server.test.js",
    "test:checks": "bun test test/checks.test.js",
    "test:checks:quartz": "OWNER_ALPHA_REAL_QUARTZ=1 bun test test/checks.test.js",
    "test:deployment": "bun test --timeout 15000 test/config.test.js test/deployment-live.test.js test/forgejo-deployment.test.js test/pipeline.test.js ../../deploy/forgejo-phase-1/test",
    "test:forgejo": "bun run test:deployment",
    "test:forgejo:real": "bun test ../../deploy/forgejo-phase-1/test/runtime-acceptance.test.js",
    "test:container": "bun test ../../deploy/owner-alpha/test"
  },
  "dependencies": {
    "@cyberbaser/correction": "file:../../packages/correction",
    "@cyberbaser/linkcheck": "file:../../packages/linkcheck",
    "@cyberbaser/ofm": "file:../../packages/ofm",
    "@cyberbaser/projection": "file:../../packages/projection",
    "@cyberbaser/publish": "file:../../packages/publish",
    "@cyberbaser/trust": "file:../../packages/trust"
  }
}
