# Copy to an operator-owned mode-0600 file; values are placeholders, not secrets.
# Public config is separate from the local-only example.
ACCOUNT_FREE_INTAKE_IMAGE=sha256:replace-with-local-image-id
ACCOUNT_FREE_INTAKE_CONFIG_PATH=/absolute/path/account-free-intake.public.json
ACCOUNT_FREE_INTAKE_BINDINGS_PATH=/absolute/path/source-bindings
ACCOUNT_FREE_INTAKE_GIT_DIR=/absolute/path/source-objects.git
ACCOUNT_FREE_INTAKE_QUEUE_VOLUME=cyberbaser-account-free-intake-queue
ACCOUNT_FREE_INTAKE_NETWORK=cyberbaser-account-free-intake-internal
# Never use a tag. public-profile.js refuses this placeholder before startup.
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:REPLACE_WITH_VERIFIED_CLOUDFLARED_DIGEST
# These contain file paths only. Never paste secret values into this env file.
ACCOUNT_FREE_INTAKE_TURNSTILE_SECRET_PATH=/absolute/path/secrets/turnstile-secret
ACCOUNT_FREE_INTAKE_TUNNEL_TOKEN_PATH=/absolute/path/secrets/cloudflared-token
