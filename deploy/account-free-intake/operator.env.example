# Copy to an operator-owned mode-0600 file. Values are examples only.
# Use an immutable local image ID (sha256:...) or repository@sha256 digest.
ACCOUNT_FREE_INTAKE_IMAGE=sha256:replace-with-local-image-id
ACCOUNT_FREE_INTAKE_CONFIG_PATH=/absolute/path/account-free-intake.json
ACCOUNT_FREE_INTAKE_BINDINGS_PATH=/absolute/path/source-bindings
ACCOUNT_FREE_INTAKE_GIT_DIR=/absolute/path/source-objects.git
ACCOUNT_FREE_INTAKE_QUEUE_VOLUME=cyberbaser-account-free-intake-queue
ACCOUNT_FREE_INTAKE_NETWORK=cyberbaser-account-free-intake-internal
